{
  "name": "@criation/backend",
  "version": "0.1.0",
  "private": true,
  "description": "Criation backend API and business-logic layer",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@criation/config": "*",
    "@criation/types": "*",
    "@criation/utils": "*",
    "@criation/validation": "*",
    "cors": "^2.8.5",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.39.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12"
  }
}
