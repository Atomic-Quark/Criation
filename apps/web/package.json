{
  "name": "@criation/web",
  "version": "0.1.0",
  "private": true,
  "description": "Criation customer-facing website",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "seed:admin": "npx tsx scripts/seed-admin.ts",
    "sync:catalog": "npx tsx scripts/sync-catalog.ts",
    "clean": "node -e \"require('node:fs').rmSync('.next',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@criation/api": "*",
    "@criation/config": "*",
    "@criation/types": "*",
    "@criation/ui": "*",
    "@criation/utils": "*",
    "@criation/validation": "*",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.10",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.33.0",
    "mongoose": "^9.9.3",
    "next": "16.3.0",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.0.0",
    "@types/react": "~19.2.2",
    "@types/react-dom": "~19.2.2",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9.39.0",
    "tailwindcss": "^4"
  }
}
