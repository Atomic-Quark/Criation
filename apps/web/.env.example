# MongoDB Connection URL (Local MongoDB or MongoDB Atlas)
MONGODB_URI=mongodb://localhost:27017/criation

# JWT Authentication Secret (Required: Generate 32+ character random secret in production)
JWT_SECRET=your_secure_random_jwt_secret_min_32_chars

# Storage Configuration
UPLOAD_DIR=public/uploads
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Admin / Seed Secret for database seeding
ADMIN_SEED_SECRET=your_secure_admin_seed_secret
