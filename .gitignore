# =============================================================================
# Criation Monorepo - Git Ignore Rules
# =============================================================================

# Dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/releases
!.yarn/plugins
!.yarn/versions

# Build Outputs & Caches
.next/
out/
dist/
build/
.turbo/
.cache/
*.tsbuildinfo
next-env.d.ts
expo-env.d.ts

# Expo & React Native
.expo/
.expo-shared/
.metro-health-check*
android/
ios/
apps/mobile/android/
apps/mobile/ios/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Environment Variables (Never commit real secrets)
.env
.env.*
!.env.example
!apps/web/.env.example

# Logs & Diagnostics
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
lerna-debug.log*
.npm

# Testing & Coverage
coverage/

# IDEs & Operating System Files
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.pem

# User Uploaded Media (Runtime Storage - ignore uploaded binaries but track .gitkeep)
**/public/uploads/*
!**/public/uploads/.gitkeep

# Local Personal / Scratch Directories
pp/
scratch/
