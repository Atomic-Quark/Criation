# ---------------------------------------------------------------------------
# Criation — example environment configuration
#
# Copy this file to `.env` and fill in real values. `.env` is git-ignored and
# must never be committed. This file must only ever contain placeholders.
#
#   cp .env.example .env
#
# Client-side variables are inlined into the bundle at build time, so anything
# prefixed NEXT_PUBLIC_ / EXPO_PUBLIC_ is PUBLIC. Never put a secret there.
# ---------------------------------------------------------------------------

# --- Shared -----------------------------------------------------------------
# development | test | production
APP_ENV=development

# --- backend/api ------------------------------------------------------------
PORT=4000
# Comma-separated list of origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Postgres connection string. Replace with your own; never commit a real one.
DATABASE_URL=postgresql://user:password@localhost:5432/criation
# Secret used to sign session tokens. Generate with: openssl rand -base64 32
JWT_SECRET=replace-me-with-a-random-32-byte-secret
JWT_EXPIRES_IN=7d

# --- apps/web (Next.js, public) ---------------------------------------------
NEXT_PUBLIC_APP_NAME=Criation
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_ENV=development

# --- apps/admin (Next.js, public) -------------------------------------------
# Admin runs on 3001 so it can sit alongside web on 3000.
NEXT_PUBLIC_ADMIN_APP_NAME=Criation Admin
NEXT_PUBLIC_ADMIN_API_URL=http://localhost:4000

# --- apps/mobile (Expo, public) ---------------------------------------------
# Use your machine's LAN IP instead of localhost when testing on a device.
EXPO_PUBLIC_APP_NAME=Criation
EXPO_PUBLIC_API_URL=http://localhost:4000
EXPO_PUBLIC_APP_ENV=development
