{
  "name": "@criation/config",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared configuration (TypeScript, ESLint, Prettier) for the Criation monorepo",
  "exports": {
    ".": "./src/index.ts",
    "./env": "./src/env.ts",
    "./tsconfig/*": "./tsconfig/*",
    "./eslint": "./eslint/base.mjs",
    "./eslint/*": "./eslint/*",
    "./prettier": "./prettier/index.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@eslint/js": "^9.39.0",
    "eslint-config-expo": "^57.0.1",
    "eslint-config-next": "16.3.0",
    "globals": "^16.5.0",
    "typescript-eslint": "^8.46.0"
  },
  "devDependencies": {
    "eslint": "^9.39.0"
  }
}
