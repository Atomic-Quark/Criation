{
  "name": "@criation/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Criation design tokens and UI components, with web and React Native entrypoints",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./web": "./src/web/index.ts",
    "./native": "./src/native/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@criation/types": "*",
    "@criation/utils": "*"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-native": ">=0.80"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    }
  },
  "devDependencies": {
    "@criation/config": "*",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.0",
    "react": "19.2.3",
    "react-native": "0.86.2"
  }
}
